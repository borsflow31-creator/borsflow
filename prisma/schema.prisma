model AutomationTrigger {
  id           String          @id @default(cuid())
  automationId String
  automation   EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         String // 'lead_created', 'stage_changed', 'status_changed', 'tag_added', 'custom_event', 'time_based'
  conditions   String // JSON array of trigger conditions
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([automationId])
  @@index([type])
}

model AutomationStep {
  id            String          @id @default(cuid())
  automationId  String
  automation    EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  templateId    String?
  template      EmailTemplate?  @relation(fields: [templateId], references: [id])
  order         Int
  name          String
  description   String?
  delayMinutes  Int             @default(0) // Delay before sending this step
  sendCondition String? // JSON array of conditions for sending
  emails        Email[]
  totalSent     Int             @default(0)
  totalOpened   Int             @default(0)
  totalClicked  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([automationId, order])
  @@index([automationId])
}

/// One subject's progress through one automation. The unique triple gives dedupe
/// for free: re-entering a stage revives the existing row at step 0 instead of
/// creating a parallel enrollment.
///
/// Subject-typed rather than lead-typed because a buyer with interests in two
/// properties must be enrolled twice in a viewing-follow-up sequence, once per
/// interest, progressing independently. Keyed on (automationId, leadId) that was
/// impossible -- the second enrollment collided with the first.
model AutomationEnrollment {
  id               String          @id @default(cuid())
  automationId     String
  automation       EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// 'Lead' | 'Property' | 'Interest' | 'Mandate'. Enforced by a CHECK constraint.
  subjectType      String
  /// Polymorphic, so no foreign key. Rows orphaned by an Interest or Mandate
  /// delete are swept by the statement triggers in
  /// prisma/migrations/20261007060000_subject_purge_triggers -- which Prisma
  /// cannot see, so do not infer from this schema that nothing cleans them up.
  subjectId        String
  /// The contact this enrollment mails: the lead itself, an interest's buyer, a
  /// property's or a mandate's vendor. Never null -- a subject with no reachable
  /// contact is not enrolled. Carries the cascade and feeds EmailRecipient.leadId.
  /// Always derived through contactLeadIdFor() in src/lib/crm/subjects.ts, never
  /// hand-built.
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspaceId      String
  status           String          @default("active") // 'active', 'completed', 'exited', 'cancelled'
  currentStepOrder Int             @default(0)
  nextStepAt       DateTime? // null unless active
  triggerContext   String? // JSON { fromStage, toStage, pipelineId, triggerId }
  enrolledAt       DateTime        @default(now())
  completedAt      DateTime?
  exitedAt         DateTime?
  exitReason       String?
  emails           Email[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([automationId, subjectType, subjectId])
  @@index([status, nextStepAt])
  @@index([subjectType, subjectId])
  @@index([leadId])
  @@index([workspaceId])
}

model SegmentationRule {
  id             String          @id @default(cuid())
  name           String
  description    String?
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The subject the criteria are evaluated against: 'Lead', 'Property',
  /// 'Interest' or 'Mandate'. Decides which fields the builder offers and which
  /// rows calculateSegmentSize loads.
  subjectType    String          @default("Lead")
  criteria       String // JSON array of criteria
  logicOperator  String          @default("AND") // 'AND' or 'OR'
  isActive       Boolean         @default(true)
  estimatedSize  Int? // Cached estimate of segment size
  lastCalculated DateTime?
  members        SegmentMember[]
  campaigns      EmailCampaign[]
  tags           String? // JSON array of tags
  createdById    String?
  updatedBy      String?
  createdBy      User?           @relation("SegmentationRuleCreator", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId])
  @@index([isActive])
  @@index([subjectType])
  @@index([createdById])
}

/// One subject's membership of one segment, materialized by calculateSegmentSize.
model SegmentMember {
  id                 String           @id @default(cuid())
  segmentationRuleId String
  segmentationRule   SegmentationRule @relation(fields: [segmentationRuleId], references: [id], onDelete: Cascade)
  /// 'Lead' | 'Property' | 'Interest' | 'Mandate'. Matches the owning rule's
  /// subjectType; a rule whose subjectType changes has its members swept.
  subjectType        String
  /// Polymorphic, so no foreign key. Rows orphaned by a Property, Interest or
  /// Mandate delete are swept by the statement triggers in
  /// prisma/migrations/20261007060000_subject_purge_triggers -- which Prisma
  /// cannot see, so do not infer from this schema that nothing cleans them up.
  subjectId          String
  /// The contact this membership mails: the lead itself, an interest's buyer, a
  /// property's or a mandate's vendor -- null only for a property whose vendor is
  /// not recorded yet. Sits outside every unique index and is non-unique by
  /// design (one buyer legitimately has many interest memberships). Kept
  /// consistent with subjectType by a CHECK constraint, and always derived through
  /// contactLeadIdFor() in src/lib/crm/subjects.ts.
  leadId             String?
  lead               Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  matchedAt          DateTime         @default(now())
  score              Float? // Subject score within segment; see SubjectLoader.score
  /// Legacy. Snapshotted {status, stage, value}, which was stale the moment it was
  /// written and duplicates what subjectId already reaches. No longer written.
  metadata           String?

  @@unique([segmentationRuleId, subjectType, subjectId])
  @@index([segmentationRuleId])
  @@index([subjectType, subjectId])
  @@index([leadId])
}

model EmailProvider {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  type             String // 'sendgrid', 'ses', 'resend', 'mailgun', 'postmark', 'custom'
  apiKey           String?
  apiKeyEncrypted  String?
  region           String?
  fromEmail        String
  fromName         String?
  replyTo          String?
  config           String? // JSON object for provider-specific config
  domain           String? // Mailgun sending domain, found from the From address on save
  // Bounce/complaint webhook that BorsFlow creates on the client's own provider
  // account when the provider is saved, so clients never copy a URL or a secret.
  webhookId        String? // the provider's id for it (Mailgun: JSON list of event types)
  webhookSecret    String? // encrypted signing secret, verification key or basic-auth password
  webhookStatus    String? // 'active', 'error', 'unsupported', 'waiting_public_url'
  webhookError     String? // plain-language reason shown to the client when not active
  webhookUpdatedAt DateTime?
  isActive         Boolean   @default(true)
  isDefault        Boolean   @default(false)
  dailyLimit       Int?
  monthlyLimit     Int?
  lastUsedAt       DateTime?
  createdById      String?
  updatedBy        String?
  createdBy        User?     @relation("EmailProviderCreator", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId])
  @@index([type])
  @@index([isActive])
  @@index([createdById])
}

model EmailQueue {
  id            String    @id @default(cuid())
  emailId       String    @unique
  email         Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  priority      Int       @default(5) // 1-10, 1 is highest
  scheduledFor  DateTime  @default(now())
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  status        String    @default("pending") // 'pending', 'processing', 'completed', 'failed'
  error         String?
  providerId    String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([scheduledFor])
  @@index([status])
  @@index([priority])
}

// Bounces, unsubscribes and suppressions belong to the workspace whose mail
// produced them: one client's bounce or opt-out must not stop another client from
// emailing that address. Rows written before this was scoped have no workspace
// and no longer affect any send.
model EmailBounce {
  id              String     @id @default(cuid())
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  recipientEmail  String
  recipientId     String?
  type            String // 'hard', 'soft', 'spam', 'blocked'
  subType         String?
  reason          String?
  providerType    String?
  providerMessage String?
  occurredAt      DateTime   @default(now())
  createdAt       DateTime   @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([recipientEmail])
  @@index([type])
  @@index([occurredAt])
}

model EmailUnsubscribe {
  id             String     @id @default(cuid())
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email          String
  leadId         String?
  campaignId     String?
  reason         String?
  source         String // 'link', 'reply', 'admin', 'api'
  unsubscribedAt DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@unique([workspaceId, email])
  @@index([email])
  @@index([leadId])
  @@index([campaignId])
}

model EmailSuppression {
  id           String     @id @default(cuid())
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  type         String // 'bounce', 'complaint', 'manual', 'spam'
  reason       String?
  source       String?
  isActive     Boolean    @default(true)
  suppressedAt DateTime   @default(now())
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([workspaceId, email, type])
  @@index([workspaceId])
  @@index([email])
  @@index([type])
  @@index([isActive])
}

model CalendarIntegration {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String // 'calcom', 'google_calendar', 'outlook_calendar'
  name        String // User-defined name for this integration
  isActive    Boolean   @default(true)

  // OAuth 2.0 Credentials (encrypted)
  accessToken    String? // Encrypted access token
  refreshToken   String? // Encrypted refresh token
  tokenExpiresAt DateTime?
  scope          String? // Granted OAuth scopes

  // Provider-specific configuration
  providerUserId String? // External user ID from provider
  providerEmail  String? // Email from provider
  calendarId     String? // Specific calendar ID to sync

  // Sync configuration
  syncEnabled   Boolean   @default(true)
  syncDirection String    @default("bidirectional") // 'import_only', 'export_only', 'bidirectional'
  lastSyncAt    DateTime?
  syncFrequency String    @default("hourly") // 'realtime', 'hourly', 'daily', 'manual'

  // Sync status tracking
  syncStatus      String    @default("active") // 'active', 'error', 'paused', 'disabled'
  lastSyncError   String?
  lastSyncErrorAt DateTime?

  // Booking webhook that BorsFlow creates on the client's Cal.com account on connect
  webhookId     String?
  webhookSecret String? // Encrypted
  webhookStatus String? // 'active', 'error', 'unsupported', 'waiting_public_url'
  webhookError  String?

  // Audit
  createdById String?
  updatedBy   String?
  createdBy   User?    @relation("CalendarIntegrationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  meetings Meeting[]
  syncLogs CalendarSyncLog[]

  @@unique([workspaceId, type, providerUserId])
  @@index([workspaceId])
  @@index([type])
  @@index([isActive])
  @@index([syncEnabled])
  @@index([createdById])
}

model Meeting {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Meeting details
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  duration    Int // Duration in minutes
  timezone    String   @default("UTC")

  // Meeting location/platform
  meetingType String // 'in_person', 'online', 'phone'
  location    String? // Physical address or phone number

  // Platform-specific data
  platform              String // 'calcom', 'zoom', 'google_meet', 'microsoft_teams'
  platformMeetingId     String? // External meeting ID
  platformEventId       String? // External event ID (for Cal.com events)
  calendarIntegrationId String?
  calendarIntegration   CalendarIntegration? @relation(fields: [calendarIntegrationId], references: [id], onDelete: SetNull)

  // Meeting links
  meetingUrl String? // Join URL
  hostUrl    String? // Host/Start URL
  password   String? // Meeting password (encrypted)

  // Conference details
  conferenceProvider String? // 'zoom', 'google_meet', 'microsoft_teams'
  conferenceId       String? // Conference ID
  conferencePhone    String? // Dial-in numbers

  // Meeting status
  status             String    @default("scheduled") // 'scheduled', 'in_progress', 'completed', 'cancelled', 'no_show'
  cancellationReason String?
  cancelledAt        DateTime?

  // CRM Integration
  leadId String?
  lead   Lead?   @relation("LeadMeetings", fields: [leadId], references: [id], onDelete: SetNull)
  userId String? // Internal user who is the meeting host
  user   User?   @relation("MeetingHost", fields: [userId], references: [id], onDelete: SetNull)

  // Attendees
  attendees MeetingAttendee[]

  // Recurrence
  isRecurring         Boolean @default(false)
  recurringPattern    String? // JSON object with recurrence rules
  recurringEventId    String? // ID of the parent recurring event
  recurringInstanceId String? // ID for this specific instance

  // Reminders
  reminderEnabled Boolean @default(true)
  reminderTimes   String? // JSON array of minutes before meeting (e.g., [15, 60, 1440])

  // Sync tracking
  externalSyncId String? // External sync identifier
  lastSyncedAt   DateTime?
  isExternal     Boolean   @default(false) // True if created externally (Cal.com)
  syncStatus     String    @default("synced") // 'synced', 'pending', 'error', 'conflict'
  syncError      String?

  // Audit
  createdById String?
  updatedBy   String?
  createdBy   User?    @relation("MeetingCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Viewings. A viewing is a meeting plus the property shown, the buyer's
  // interest in it, and structured feedback -- not a parallel appointment system.
  propertyId      String?
  property        Property?        @relation("PropertyMeetings", fields: [propertyId], references: [id], onDelete: SetNull)
  interestId      String?
  interest        Interest?        @relation("InterestMeetings", fields: [interestId], references: [id], onDelete: SetNull)
  viewingFeedback ViewingFeedback?

  // Relations
  notes      MeetingNote[]
  activities Activity[]

  @@unique([platformEventId, platform])
  @@index([workspaceId])
  @@index([leadId])
  @@index([userId])
  @@index([startTime])
  @@index([status])
  @@index([platform])
  @@index([calendarIntegrationId])
  @@index([isExternal])
  @@index([createdById])
  @@index([propertyId, startTime])
  @@index([interestId])
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Attendee details
  name  String
  email String
  phone String?

  // Attendee type
  type   String  @default("external") // 'internal', 'external', 'lead', 'contact'
  userId String? // If internal user
  leadId String? // If lead
  lead   Lead?   @relation("LeadAttendees", fields: [leadId], references: [id], onDelete: SetNull)

  // Attendance status
  status     String    @default("invited") // 'invited', 'accepted', 'declined', 'tentative', 'attended', 'no_show'
  responseAt DateTime?

  // External attendee ID
  externalAttendeeId String? // ID from calendar provider

  // Join tracking
  joinedAt DateTime?
  leftAt   DateTime?
  joinUrl  String? // Personal join URL if available

  // Reminder status
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, email])
  @@index([meetingId])
  @@index([email])
  @@index([status])
}

model MeetingNote {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Note content
  content  String
  noteType String @default("general") // 'general', 'action_item', 'decision', 'follow_up'

  // Visibility
  isPrivate Boolean @default(false)

  // Author
  createdById String
  createdBy   User   @relation("MeetingNoteCreator", fields: [createdById], references: [id])

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
  @@index([createdById])
}

model CalendarSyncLog {
  id                    String              @id @default(cuid())
  calendarIntegrationId String
  calendarIntegration   CalendarIntegration @relation(fields: [calendarIntegrationId], references: [id], onDelete: Cascade)

  // Sync operation details
  operationType String // 'full_sync', 'incremental_sync', 'event_create', 'event_update', 'event_delete'
  status        String // 'started', 'completed', 'failed', 'partial'

  // Sync statistics
  eventsProcessed Int @default(0)
  eventsCreated   Int @default(0)
  eventsUpdated   Int @default(0)
  eventsDeleted   Int @default(0)
  eventsSkipped   Int @default(0)

  // Error handling
  errorMessage String?
  errorDetails String? // JSON object with detailed error info

  // Performance metrics
  durationMs  Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // Sync range
  syncStartDate DateTime?
  syncEndDate   DateTime?

  @@index([calendarIntegrationId])
  @@index([status])
  @@index([startedAt])
}

model VideoConferenceConfig {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Platform configuration
  platform String // 'zoom', 'google_meet', 'microsoft_teams'
  name     String // User-friendly name

  // OAuth credentials
  accessToken    String? // Encrypted
  refreshToken   String? // Encrypted
  tokenExpiresAt DateTime?

  // Provider-specific settings
  providerUserId String?
  providerEmail  String?

  // Default meeting settings
  defaultSettings String? // JSON object with default meeting settings

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // Is this the default platform?

  // Audit
  createdById String?
  updatedBy   String?
  createdBy   User?    @relation("VideoConferenceConfigCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, platform])
  @@index([workspaceId])
  @@index([platform])
  @@index([isActive])
  @@index([createdById])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Activity details
  type       String // 'meeting_created', 'meeting_updated', 'meeting_cancelled', 'meeting_completed', 'attendee_added', 'note_added'
  entityType String // 'meeting', 'attendee', 'note'
  entityId   String

  // Activity description
  description String
  metadata    String? // JSON object with additional context

  // User who performed the action
  userId String
  user   User   @relation("ActivityUser", fields: [userId], references: [id])

  // Related entities
  meetingId  String?
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  leadId     String?
  // Real estate. Plain columns like leadId, with no foreign key: the feed is an
  // append-only history and must outlive the rows it describes. They let one event
  // appear on every timeline it belongs to -- a viewing's feedback shows on the
  // property, on the buyer's interest and on the buyer's lead.
  propertyId String?
  interestId String?

  // Audit
  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([meetingId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([propertyId, createdAt])
  @@index([interestId, createdAt])
}

// One row per delivered notification. `dedupeKey` is unique per recipient so a
// cron tick or a webhook replay that fires notify() twice for the same event
// (e.g. `meeting.reminder:<id>`) cannot create a second row.
model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type     String // 'invitation.accepted', 'quote.accepted', 'meeting.cancelled', ... (see src/lib/notifications/types.ts)
  category String // 'team' | 'sales' | 'meetings' | 'tasks'
  title    String
  body     String?
  href     String? // in-app link the notification opens when clicked

  readAt    DateTime?
  emailedAt DateTime?
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([workspaceId])
}

model PageAccess {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  level     String // 'VIEW' | 'EDIT'
  grantedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
  @@index([pageId])
}

model TemplateCategory {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  icon        String?
  order       Int                 @default(0)
  templates   UniversalTemplate[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model UniversalTemplate {
  id           String              @id @default(cuid())
  name         String
  description  String?
  type         String // 'page' | 'quote' | 'invoice' | 'kanban'
  categoryId   String?
  category     TemplateCategory?   @relation(fields: [categoryId], references: [id])
  workspaceId  String? // null = system/global template
  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isSystem     Boolean             @default(false)
  isPublic     Boolean             @default(false)
  content      String              @default("{}") // JSON blob (shape per type)
  previewImage String?
  icon         String?
  tags         String? // JSON array
  version      Int                 @default(1)
  parentId     String?
  parent       UniversalTemplate?  @relation("TemplateVersions", fields: [parentId], references: [id])
  versions     UniversalTemplate[] @relation("TemplateVersions")
  usageCount   Int                 @default(0)
  createdById  String?
  createdBy    User?               @relation("UniversalTemplateCreator", fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([type])
  @@index([workspaceId])
  @@index([isSystem])
  @@index([categoryId])
}

// Generic sliding-window event log backing src/lib/api/rate-limit.ts.
// One row per limited action; `cost` lets a bulk request count as N.
model RateLimitEvent {
  id        String   @id @default(cuid())
  bucket    String // what is being limited, e.g. 'invitation:send'
  subject   String // who it is counted against, e.g. 'user:<id>' or 'workspace:<id>'
  cost      Int      @default(1)
  createdAt DateTime @default(now())

  @@index([bucket, subject, createdAt])
  @@index([createdAt]) // pruning
}

// ─── SaaS billing ────────────────────────────────────────────────────────────
// Pricing is flat per workspace, never per user. Limits live in src/lib/billing/plans.ts.

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

// The workspace's Stripe Billing subscription. Unused until paid plans launch
// (NEXT_PUBLIC_BILLING_ENABLED); Workspace.plan is what limits are read from.
model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  status               String // Stripe status: 'trialing', 'active', 'past_due', 'canceled', ...
  priceId              String
  interval             String // 'month' | 'year'
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Pooled monthly usage per workspace, e.g. AI credits. One row per metric per
// calendar month (UTC), so a new month starts from zero without a reset job.
model UsageCounter {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String // 'ai_credits' | 'email_sends' | 'invoices'
  period      String // 'YYYY-MM'
  used        Int       @default(0)
  bonus       Int       @default(0) // purchased packs on top of the plan's allowance
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, metric, period])
}

// One row per AI request: what was sent to which model, and what it cost. The
// audit trail behind UsageCounter's 'ai_credits' total. userId has no foreign key
// so the history survives a member leaving.
model AiUsageEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  feature      String // 'agent' | 'complete' | 'template' | 'product' | 'email_template'
  model        String
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  credits      Int       @default(0)
  period       String // 'YYYY-MM', the UsageCounter row that was charged
  status       String // 'ok' | 'error' | 'aborted'
  createdAt    DateTime  @default(now())

  @@index([workspaceId, period])
  @@index([userId])
}

// "Notify me" sign-ups for paid plans while only Free is available.
model PlanWaitlist {
  id               String   @id @default(cuid())
  email            String
  tier             PlanTier
  userId           String?
  workspaceId      String?
  foundingDiscount Boolean  @default(true) // beta testers keep the founding price
  createdAt        DateTime @default(now())

  @@unique([email, tier])
}

// ─── Real estate ─────────────────────────────────────────────────────────────

/// A listing: the agency's inventory. Product stays as the catalog of billable
/// services and fees (agency fee, photography, staging, EPC); it cannot carry a
/// listing -- no images, no structured address, no coordinates.
///
/// Also the card on the owner (acquisition) board: its vendor is its contact, its
/// `stage` is the column and its `status` is the lifecycle, which does not depend
/// on any buyer.
model Property {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Agency-facing reference, e.g. "APT-0142". Unique per workspace.
  reference       String
  title           String
  description     String?
  /// 'apartment' | 'house' | 'land' | 'commercial' | 'parking' | 'building' | 'other'
  propertyType    String
  /// 'sale' | 'rent'. Sale-first: the column exists so rental is additive later,
  /// but nothing here implements tenancy.
  transactionType String    @default("sale")
  /// Lifecycle, independent of any buyer: 'prospect' | 'valuation' | 'mandate' |
  /// 'live' | 'under_offer' | 'sold' | 'withdrawn' | 'expired'
  status          String    @default("prospect")

  // Owner board
  pipelineId String?
  pipeline   Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage      String    @default("Prospect")
  order      Int       @default(0)

  // The seller. Optional because a prospect is sometimes recorded before the
  // vendor is; it is the property's contact for mail and automations.
  vendorId String?
  vendor   Lead?   @relation("PropertyVendor", fields: [vendorId], references: [id], onDelete: SetNull)

  // Price
  price     Float     @default(0)
  /// null = the workspace currency
  currency  String?
  soldAt    DateTime?
  soldPrice Float?

  // Address and geo. latitude/longitude are what a radius search and a map view
  // need; a free-text category could never do either.
  addressLine     String?
  /// The street address is withheld from public pages unless this is set.
  isAddressPublic Boolean @default(false)
  city            String
  district        String?
  postalCode      String?
  /// ISO 3166-1 alpha-2
  countryCode     String?
  latitude        Float?
  longitude       Float?

  // Characteristics
  surfaceArea  Float? // m2
  landArea     Float?
  rooms        Int?
  bedrooms     Int?
  bathrooms    Int?
  floor        Int?
  buildYear    Int?
  /// 'A'..'G'
  energyRating String?
  hasElevator  Boolean @default(false)
  hasParking   Boolean @default(false)
  hasBalcony   Boolean @default(false)
  hasTerrace   Boolean @default(false)
  hasGarden    Boolean @default(false)
  hasPool      Boolean @default(false)
  furnished    Boolean @default(false)
  /// Values for the workspace's ProductCustomField definitions of entityType 'property'.
  customFields Json    @default("{}")

  // Publication. publicToken is the unguessable key of the public listing page.
  isPublished          Boolean   @default(false)
  publishedAt          DateTime?
  /// When the property first went live; days-on-market counts from here.
  listedAt             DateTime?
  publicToken          String?   @unique
  publicTokenCreatedAt DateTime?

  /// The listing agent.
  ownerId     String?
  owner       User?   @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?   @relation("PropertyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  media           PropertyMedia[]
  mandates        Mandate[]
  interests       Interest[]
  offers          Offer[]
  meetings        Meeting[]         @relation("PropertyMeetings")
  viewingFeedback ViewingFeedback[]
  matches         PropertyMatch[]
  commissions     Commission[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  // The searches agents actually run: by area, price band, type and status.
  @@index([workspaceId, status, price])
  @@index([workspaceId, propertyType, status, price])
  @@index([workspaceId, city, status, price])
  @@index([workspaceId, bedrooms, status])
  @@index([pipelineId, stage, order])
  @@index([vendorId])
  @@index([ownerId])
  @@index([workspaceId, publishedAt])
}

/// An ordered, typed item attached to a listing. Stored the way LeadFile is:
/// private bucket, path scoped per workspace, short-lived signed URLs. The bucket
/// is never public -- public pages and portal feeds reach images through a proxy
/// route that mints a fresh signed URL per request, so a URL handed to a portal
/// cannot rot, and vendor paperwork sharing the bucket is never exposed.
model PropertyMedia {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// 'photo' | 'floorplan' | 'video' | 'virtual_tour'
  kind         String    @default("photo")
  /// crm/<workspaceId>/properties/<propertyId>/<uuid>.<ext>. Null for a video or
  /// virtual tour that lives elsewhere, which is then described by externalUrl.
  filePath     String?
  externalUrl  String?
  fileName     String?
  fileType     String?
  size         Int?
  width        Int?
  height       Int?
  caption      String?
  /// Display order within the property.
  position     Int       @default(0)
  /// At most one per property; enforced in the service because Prisma cannot
  /// express a partial unique index.
  isCover      Boolean   @default(false)
  uploadedById String?
  uploadedBy   User?     @relation("PropertyMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([propertyId, position])
  @@index([workspaceId])
}

/// The authority to sell a property, with its expiry clock. Expiry drives a work
/// queue: expiring within 30 days means a renewal call, expired means de-list.
model Mandate {
  id                   String               @id @default(cuid())
  workspaceId          String
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reference            String
  propertyId           String
  property             Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// The vendor.
  leadId               String
  lead                 Lead                 @relation("MandateVendor", fields: [leadId], references: [id], onDelete: Cascade)
  /// 'simple' | 'exclusive' | 'semi_exclusive'
  mandateType          String               @default("simple")
  /// 'draft' | 'active' | 'expired' | 'terminated' | 'completed'
  status               String               @default("draft")
  startDate            DateTime?
  endDate              DateTime?
  /// Free-text renewal terms, e.g. "tacit renewal, 3 months, 15 days notice".
  renewalTerms         String?
  askingPrice          Float                @default(0)
  /// What the vendor wants to receive after fees, when agreed.
  netToVendor          Float?
  /// 'percent' | 'fixed'
  feeType              String               @default("percent")
  commissionPercent    Float?
  feeFixed             Float?
  /// Who pays the fee: 'vendor' | 'buyer' | 'shared'
  feePayer             String               @default("vendor")
  signedAt             DateTime?
  terminatedAt         DateTime?
  terminationReason    String?
  /// The signed document, in the private bucket.
  documentPath         String?
  documentName         String?
  notes                String?
  /// Key of the vendor report page; rotating it revokes the link.
  publicToken          String?              @unique
  publicTokenCreatedAt DateTime?
  /// A vendor report is a recurring obligation on an exclusive mandate: how often
  /// it is sent (days), and when the last one went. Null = no schedule.
  reportEveryDays      Int?
  lastReportSentAt     DateTime?
  /// The listing agent. Attribution is captured here, not inferred later: it
  /// decides who is paid on the listing side.
  ownerId              String?
  owner                User?                @relation("MandateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?                @relation("MandateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priceChanges         MandatePriceChange[]
  commissions          Commission[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  @@index([propertyId])
  @@index([leadId])
  @@index([ownerId])
  // The expiry work queue.
  @@index([status, endDate])
}

/// One asking-price reduction. Days-on-market and price drops are the two
/// numbers every seller asks about, and both feed the vendor report.
model MandatePriceChange {
  id          String   @id @default(cuid())
  mandateId   String
  mandate     Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  fromPrice   Float
  toPrice     Float
  reason      String?
  changedAt   DateTime @default(now())
  changedById String?
  changedBy   User?    @relation("MandatePriceChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([mandateId, changedAt])
}

/// One buyer's journey on one property. This row, not the lead, is what moves
/// across the buyer board: a buyer sits at "offer made" on property A and
/// "viewing booked" on property B at the same time.
model Interest {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipelineId      String
  pipeline        Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  /// The column on the buyer board. Stage names are workspace data, like
  /// Pipeline.name, so code reads them through resolveStage() rather than
  /// assuming a spelling.
  stage           String
  order           Int               @default(0)
  /// The buyer.
  leadId          String
  lead            Lead              @relation("InterestBuyer", fields: [leadId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// Outcome, not position: 'active' | 'won' | 'lost' | 'on_hold'
  status          String            @default("active")
  /// 'manual' | 'enquiry' | 'portal' | 'match' | 'walk_in' | 'referral'
  source          String?
  notes           String?
  lostReason      String?
  lastActivityAt  DateTime?
  /// The agent working this buyer; the selling-side attribution.
  ownerId         String?
  owner           User?             @relation("InterestOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// When the interest came from a new-listing match: which brief found it, and
  /// how well the property fit. Attribution is captured, not inferred later.
  searchBriefId   String?
  searchBrief     SearchBrief?      @relation(fields: [searchBriefId], references: [id], onDelete: SetNull)
  matchScore      Float?
  matches         PropertyMatch[]
  createdById     String?
  createdBy       User?             @relation("InterestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  offers          Offer[]
  commissions     Commission[]
  meetings        Meeting[]         @relation("InterestMeetings")
  viewingFeedback ViewingFeedback[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  /// One interest per buyer per property.
  @@unique([propertyId, leadId])
  @@index([workspaceId, status])
  @@index([pipelineId, stage, order])
  @@index([leadId])
  @@index([ownerId])
  @@index([searchBriefId])
}

/// An offer on a property. The pattern is Quote's -- an unguessable publicToken, a
/// public accept/reject route, a status machine, a validity date -- but the table
/// is not, because the direction is inverted: a quote is agency-to-client with
/// line items and a computed total, an offer is buyer-to-seller with one amount,
/// conditions, and competing siblings on the same property.
model Offer {
  id                   String       @id @default(cuid())
  workspaceId          String
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  propertyId           String
  property             Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  interestId           String
  interest             Interest     @relation(fields: [interestId], references: [id], onDelete: Cascade)
  /// The buyer, denormalized so "offers by this contact" needs no join.
  leadId               String
  lead                 Lead         @relation("OfferBuyer", fields: [leadId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String?
  /// 'pending' | 'accepted' | 'rejected' | 'withdrawn' | 'expired'
  status               String       @default("pending")
  offeredAt            DateTime     @default(now())
  expiresAt            DateTime?
  decidedAt            DateTime?
  decidedById          String?
  decidedBy            User?        @relation("OfferDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// 'agent' | 'vendor_link'
  decidedVia           String?
  /// 'another_offer_accepted' | 'declined' | 'withdrawn' | free text
  decisionReason       String?
  /// [{ "type": "finance" | "survey" | "chain" | "other", "note": string }]
  conditions           Json         @default("[]")
  depositAmount        Float?
  /// 'cash' | 'mortgage' | 'mixed'
  financingType        String?
  /// Key of the page where the vendor can accept or decline; rotating it revokes it.
  publicToken          String?      @unique
  publicTokenCreatedAt DateTime?
  commissions          Commission[]
  createdById          String?
  createdBy            User?        @relation("OfferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // The competing-offers query: every pending offer on one property.
  @@index([propertyId, status])
  @@index([interestId])
  @@index([workspaceId, status])
  @@index([leadId])
  @@index([status, expiresAt])
}

/// Structured feedback on a viewing, one per viewing. Load-bearing twice: it
/// refines the buyer's search brief, and it is the substance of the vendor report.
model ViewingFeedback {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetingId        String    @unique
  meeting          Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  interestId       String?
  interest         Interest? @relation(fields: [interestId], references: [id], onDelete: SetNull)
  /// The buyer.
  leadId           String
  lead             Lead      @relation("ViewingFeedbackBuyer", fields: [leadId], references: [id], onDelete: Cascade)
  attended         Boolean   @default(true)
  /// A verdict per dimension, each 'negative' | 'neutral' | 'positive'.
  priceVerdict     String?
  conditionVerdict String?
  locationVerdict  String?
  layoutVerdict    String?
  /// 1 (not interested) .. 5 (very interested)
  interestLevel    Int?
  comments         String?
  recordedById     String?
  recordedBy       User?     @relation("ViewingFeedbackRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // The vendor report: what viewers said about this property.
  @@index([propertyId, createdAt])
  @@index([interestId])
  @@index([leadId])
  @@index([workspaceId])
}

/// What a buyer is looking for, stored on the lead and evaluated against NEW
/// properties -- the inverse of a segment, where criteria live on the rule and are
/// evaluated against leads. A buyer routinely has two (own home, investment), so
/// it is a table, not columns on Lead.
///
/// The columns are split on purpose. The numeric bands and must-have flags are
/// scalars so Postgres can prefilter by index when a listing goes live, without
/// loading every brief; the small sets (types, cities) are stringified JSON arrays
/// filtered in code; and `criteria` is an escape hatch evaluated with the same
/// matchesCriteria the segment builder uses.
model SearchBrief {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead      @relation("SearchBriefLead", fields: [leadId], references: [id], onDelete: Cascade)
  name            String
  isActive        Boolean   @default(true)
  /// Whether the buyer is mailed about matches. Agents are alerted regardless.
  notifyByEmail   Boolean   @default(true)
  transactionType String    @default("sale")

  priceMin         Float?
  priceMax         Float?
  surfaceMin       Float?
  bedroomsMin      Int?
  roomsMin         Int?
  mustHaveParking  Boolean @default(false)
  mustHaveElevator Boolean @default(false)
  mustHaveGarden   Boolean @default(false)
  mustHaveTerrace  Boolean @default(false)
  mustHaveBalcony  Boolean @default(false)

  /// JSON arrays; null or empty = any.
  propertyTypes String?
  cities        String?
  districts     String?

  /// JSON Criteria[], evaluated against the property row.
  criteria      String?
  logicOperator String  @default("AND")

  notes         String?
  lastMatchedAt DateTime?
  matchCount    Int             @default(0)
  ownerId       String?
  owner         User?           @relation("SearchBriefOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?           @relation("SearchBriefCreator", fields: [createdById], references: [id], onDelete: SetNull)
  matches       PropertyMatch[]
  interests     Interest[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([workspaceId, isActive])
  @@index([leadId])
  // The prefilter when a listing goes live: briefs whose band contains its price.
  @@index([workspaceId, isActive, priceMax])
  @@index([workspaceId, isActive, priceMin])
}

/// A property that fits a brief. Without this table a price drop would re-notify
/// the same buyer forever, the agent would have no inbox of matches to action, and
/// an interest would have no record of how it was found.
///
/// The unique pair is the whole idempotence mechanism: re-running the matcher is a
/// createMany with skipDuplicates.
model PropertyMatch {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  searchBriefId String
  searchBrief   SearchBrief @relation(fields: [searchBriefId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead        @relation("PropertyMatchLead", fields: [leadId], references: [id], onDelete: Cascade)
  /// 0..100
  score         Float
  /// [{ "key": "price_fit", "weight": 40 }, ...] for the agent view and the email.
  reasons       Json        @default("[]")
  /// 'new' | 'notified' | 'dismissed' | 'interested' | 'converted'
  status        String      @default("new")
  notifiedAt    DateTime?
  dismissedAt   DateTime?
  /// Set when an agent turns the match into an interest.
  interestId    String?
  interest      Interest?   @relation(fields: [interestId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([propertyId, searchBriefId])
  @@index([workspaceId, status])
  @@index([searchBriefId, createdAt])
  @@index([leadId, status])
  // The digest cron's claim query.
  @@index([status, createdAt])
}

/// What the agency earns on a sale. Revenue here is a percentage of the sale price,
/// split between the listing agent, the selling agent and the agency, realized at
/// closing and often paid through a notary or escrow rather than billed to the
/// client -- so it is not an Invoice. (Quote and Invoice stay for what they are good
/// at: billing the agency's own fees, such as photography or staging.)
///
/// It accrues when an offer is accepted, with the terms snapshotted from the
/// mandate so a later renegotiation of the mandate cannot rewrite what was agreed on
/// this sale. Attribution comes from the rows themselves -- Mandate.ownerId is the
/// listing side, Interest.ownerId the selling side -- captured when the work was
/// done rather than guessed at when it is time to pay.
model Commission {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mandateId   String?
  mandate     Mandate?          @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  interestId  String?
  interest    Interest?         @relation(fields: [interestId], references: [id], onDelete: SetNull)
  offerId     String?
  offer       Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// 'accrued' (offer accepted, sale pending) | 'realized' (sale closed) | 'paid' | 'cancelled'
  status      String            @default("accrued")
  /// The agreed sale price the fee is computed on.
  basis       Float
  /// Snapshot of the mandate's terms: 'percent' | 'fixed'
  feeType     String            @default("percent")
  feePercent  Float?
  feeFixed    Float?
  /// The total fee, before it is shared out.
  grossAmount Float
  currency    String?
  realizedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  createdById String?
  createdBy   User?             @relation("CommissionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  splits      CommissionSplit[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, status])
  @@index([propertyId])
  @@index([offerId])
}

/// One person's (or the agency's) share of a commission.
model CommissionSplit {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The member earning it; null is the agency's own share.
  userId       String?
  user         User?      @relation("CommissionSplitUser", fields: [userId], references: [id], onDelete: SetNull)
  /// 'listing_agent' | 'selling_agent' | 'introducer' | 'agency' | 'manager'
  role         String
  /// Percentage of the commission's grossAmount, 0..100 (a CHECK enforces the range).
  sharePercent Float
  /// sharePercent resolved to money when the split is saved.
  amount       Float
  /// 'pending' | 'approved' | 'paid'
  status       String     @default("pending")
  approvedAt   DateTime?
  paidAt       DateTime?
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([commissionId])
  @@index([userId, status])
  @@index([workspaceId, status])
}

/// An outbound listing feed for a portal (SeLoger, Idealista, Rightmove, Immoweb,
/// Zillow). The portal fetches it with the token, so the token is the credential:
/// rotating it revokes the portal's access. Most demand arrives from portals, and
/// this is how stock gets there; their enquiries come back through the same intake
/// as every other enquiry.
// ============================================================================
// DEVELOPER CRM (PROMOTION IMMOBILIÈRE)
// ============================================================================

/// Upstream land prospecting and feasibility (Prospection Foncière).
model LandDeal {
  id               String      @id @default(cuid())
  workspaceId      String
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reference        String
  title            String
  description      String?
  address          String?
  city             String
  postalCode       String?
  cadastralRef     String?
  plotArea         Float?      // m²
  zoning           String?     // PLU zone e.g. "Zone UB"
  /// 'prospecting' | 'feasibility' | 'unilateral_agreement' | 'permit_filed' | 'permit_cleared' | 'deed_signed' | 'abandoned'
  status           String      @default("prospecting")
  targetUnits      Int?
  sellableArea     Float?      // m² SDP
  landPrice        Float?
  estimatedRevenue Float?
  estimatedCost    Float?
  projectedMargin  Float?      // %
  vendorLeadId     String?
  vendorLead       Lead?       @relation("LandDealVendor", fields: [vendorLeadId], references: [id], onDelete: SetNull)
  permitNumber     String?
  permitFiledAt    DateTime?
  permitGrantedAt  DateTime?
  permitClearedAt  DateTime?
  deedSignedAt     DateTime?
  program          Program?
  createdById      String?
  createdBy        User?       @relation("LandDealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId     String?
  assignedTo       User?       @relation("LandDealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes            String?
  customFields     Json        @default("{}")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  @@index([vendorLeadId])
  @@index([assignedToId])
}

/// A real estate development program (Programme Immobilier / Off-plan VEFA).
model Program {
  id                 String                 @id @default(cuid())
  workspaceId        String
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reference          String
  name               String
  commercialName     String?
  description        String?
  /// 'residential' | 'mixed_use' | 'commercial' | 'subdivision' | 'renovation' | 'other'
  projectType        String                 @default("residential")
  /// The promoter or developer behind the project, when it is not the agency itself.
  developerName      String?
  websiteUrl         String?
  addressLine        String?
  city               String
  postalCode         String?
  countryCode        String?                @default("FR")
  latitude           Float?
  longitude          Float?
  /// 'study' | 'commercialization' | 'construction' | 'delivery' | 'completed'
  status             String                 @default("study")
  permitNumber       String?
  architectName      String?
  gfaBank            String?
  notaryName         String?
  notaryEmail        String?
  targetDeliveryDate DateTime?
  totalUnits         Int                    @default(0)
  availableUnits     Int                    @default(0)
  reservedUnits      Int                    @default(0)
  soldUnits          Int                    @default(0)
  publicToken        String?                @unique
  landDealId         String?                @unique
  landDeal           LandDeal?              @relation(fields: [landDealId], references: [id], onDelete: SetNull)
  buildings          Building[]
  lots               DevelopmentLot[]
  milestones         ConstructionMilestone[]
  media              ProgramMedia[]
  createdById        String?
  createdBy          User?                  @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  @@index([createdById])
}

/// A building or construction phase within a program (Bâtiment / Tranche).
model Building {
  id            String                  @id @default(cuid())
  programId     String
  program       Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  name          String
  floorsCount   Int                     @default(1)
  basementCount Int                     @default(0)
  lots          DevelopmentLot[]
  milestones    ConstructionMilestone[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([programId])
}

/// An individual unit / lot in a development (Apartment, Parking, Cellar, Commercial).
model DevelopmentLot {
  id                    String            @id @default(cuid())
  workspaceId           String
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  programId             String
  program               Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  buildingId            String?
  building              Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  lotNumber             String
  /// 'apartment' | 'house' | 'parking' | 'box' | 'cellar' | 'commercial'
  type                  String            @default("apartment")
  /// 'T1' | 'T2' | 'T3' | 'T4' | 'T5' | 'studio' | 'duplex' | 'commercial'
  typology              String?
  floor                 Int               @default(0)
  orientation           String?
  surfaceArea           Float             @default(0)
  terraceArea           Float?            @default(0)
  balconyArea           Float?            @default(0)
  gardenArea            Float?            @default(0)
  basePrice             Float             @default(0)
  taxRate               Float             @default(20.0)
  totalPrice            Float             @default(0)
  /// 'available' | 'optioned' | 'reserved' | 'contract_signed' | 'deed_signed' | 'delivered'
  status                String            @default("available")
  optionExpiresAt       DateTime?
  optionHolderLeadId    String?
  optionHolderLead      Lead?             @relation("LotOptionHolder", fields: [optionHolderLeadId], references: [id], onDelete: SetNull)
  buyerLeadId           String?
  buyerLead             Lead?             @relation("LotBuyer", fields: [buyerLeadId], references: [id], onDelete: SetNull)
  notaryDeedScheduledAt DateTime?
  notaryDeedSignedAt    DateTime?
  deliveredAt           DateTime?
  parentLotId           String?
  parentLot             DevelopmentLot?   @relation("LinkedLots", fields: [parentLotId], references: [id], onDelete: SetNull)
  childLots             DevelopmentLot[]  @relation("LinkedLots")
  callsForFunds         CallForFunds[]
  tmaRequests           TMARequest[]
  snags                 HandoverSnag[]
  // Public Buyer Portal (Hybrid Token + OTP)
  publicToken           String?           @unique
  publicTokenCreatedAt  DateTime?
  portalOtpCode         String?
  portalOtpExpiresAt    DateTime?
  customFields          Json              @default("{}")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([programId, lotNumber])
  @@index([workspaceId, status])
  @@index([programId, status])
  @@index([buildingId])
  @@index([buyerLeadId])
  @@index([optionHolderLeadId])
}

/// A statutory construction milestone certified by an architect (Jalon de Chantier).
model ConstructionMilestone {
  id                      String          @id @default(cuid())
  programId               String
  program                 Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  buildingId              String?
  building                Building?       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// 'FOUNDATIONS' | 'GROUND_FLOOR_SLAB' | 'ROOF_WATERTIGHT' | 'PLASTERING_COMPLETE' | 'COMPLETION' | 'DELIVERY'
  stageKey                String
  title                   String
  targetPercentage        Float           @default(0)
  order                   Int             @default(0)
  isCertified             Boolean         @default(false)
  certifiedAt             DateTime?
  architectCertificateDoc String?
  callsForFunds           CallForFunds[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([programId, order])
  @@index([buildingId])
}

/// An off-plan call for funds (Appel de Fonds) billed to the buyer.
model CallForFunds {
  id                 String                @id @default(cuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lotId              String
  lot                DevelopmentLot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  milestoneId        String
  milestone          ConstructionMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  invoiceId          String?               @unique
  invoice            Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  callNumber         String
  percentage         Float
  amount             Float
  /// 'draft' | 'issued' | 'sent_to_bank' | 'paid' | 'overdue'
  status             String                @default("draft")
  issuedAt           DateTime?
  dueAt              DateTime?
  paidAt             DateTime?
  bankName           String?
  bankLoanReference  String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([workspaceId, callNumber])
  @@index([workspaceId, status])
  @@index([lotId])
  @@index([milestoneId])
}

/// Buyer customization or change order request (Travaux Modificatifs Acquéreurs - TMA).
model TMARequest {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lotId             String
  lot               DevelopmentLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  buyerLeadId       String
  buyerLead         Lead           @relation("TMABuyer", fields: [buyerLeadId], references: [id], onDelete: Cascade)
  reference         String
  /// 'electrical' | 'plumbing' | 'partitions' | 'finishes' | 'other'
  category          String         @default("finishes")
  title             String
  description       String
  /// 'requested' | 'feasibility_approved' | 'quote_sent' | 'accepted' | 'rejected' | 'completed'
  status            String         @default("requested")
  costEstimate      Float          @default(0)
  priceQuote        Float          @default(0)
  techApprovedAt    DateTime?
  techApproverNote  String?
  signedAddendumDoc String?
  signedAt          DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  @@index([lotId])
  @@index([buyerLeadId])
}

/// Delivery inspection defect / snagging ticket (Réserves / Garantie de Parfait Achèvement).
model HandoverSnag {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lotId              String
  lot                DevelopmentLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  room               String
  trade              String
  description        String
  photoUrl           String?
  /// 'open' | 'contractor_assigned' | 'fixed_pending_validation' | 'resolved'
  status             String         @default("open")
  /// 'gpa' | 'biennale' | 'decennale'
  warrantyType       String         @default("gpa")
  contractorName     String?
  contractorEmail    String?
  dueDate            DateTime?
  resolvedAt         DateTime?
  resolvedProofPhoto String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([workspaceId, status])
  @@index([lotId])
}

/// Media and construction update gallery for a program.
model ProgramMedia {
  id                   String     @id @default(cuid())
  programId            String
  program              Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// Denormalized from the program so a workspace's objects are one prefix and
  /// cleanup does not have to join back through Program.
  workspaceId          String?
  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// 'photo' | 'drone' | 'plan' | '3d_render' | 'quarterly_report' | 'video' | 'document'
  kind                 String     @default("photo")
  title                String?
  /// crm/<workspaceId>/projects/<programId>/<uuid>.<ext>. Null for a video that
  /// lives elsewhere, which is then described by externalUrl.
  filePath             String?
  externalUrl          String?
  fileName             String?
  fileType             String?
  size                 Int?
  caption              String?
  /// Display order within the program.
  position             Int        @default(0)
  /// At most one per program; enforced in the route because Prisma cannot
  /// express a partial unique index.
  isCover              Boolean    @default(false)
  uploadedById         String?
  uploadedBy           User?      @relation("ProgramMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  isConstructionUpdate Boolean    @default(false)
  updateMonth          String?  // e.g. "2026-10"
  createdAt            DateTime   @default(now())

  @@index([programId, position])
  @@index([workspaceId])
  @@index([uploadedById])
}
