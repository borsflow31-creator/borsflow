// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                            String                  @id @default(cuid())
  email                         String                  @unique
  name                          String?
  password                      String?
  emailVerified                 DateTime?
  theme                         String                  @default("system") // 'light', 'dark', 'system'
  notificationsEmail            Boolean                 @default(true)
  notificationsPush             Boolean                 @default(true)
  // Per-category overrides: { [category]: { inApp: boolean, email: boolean } }.
  // Missing categories fall back to the defaults in src/lib/notifications/prefs.ts.
  // `notificationsEmail` above stays the master email switch, applied on top.
  notificationPrefs             Json?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  workspaces                    Workspace[]
  sessions                      Session[]
  workspaceMembers              WorkspaceMember[]
  messages                      Message[]
  comments                      Comment[]
  sentInvitations               Invitation[]            @relation("InvitationSender")
  notifications                 Notification[]          @relation("NotificationRecipient")
  actedNotifications            Notification[]          @relation("NotificationActor")
  // Meeting relationships
  hostedMeetings                Meeting[]               @relation("MeetingHost")
  createdMeetingNotes           MeetingNote[]           @relation("MeetingNoteCreator")
  activities                    Activity[]              @relation("ActivityUser")
  pageAccessRecords             PageAccess[]
  // Created by relations
  createdPages                  Page[]                  @relation("PageCreator")
  createdBlocks                 Block[]                 @relation("BlockCreator")
  createdKanbanProjects         KanbanProject[]         @relation("KanbanProjectCreator")
  createdKanbanCards            KanbanCard[]            @relation("KanbanCardCreator")
  createdPipelines              Pipeline[]              @relation("PipelineCreator")
  createdLeads                  Lead[]                  @relation("LeadCreator")
  uploadedLeadFiles             LeadFile[]              @relation("LeadFileUploader")
  createdLeadLists              LeadList[]              @relation("LeadListCreator")
  createdQuotes                 Quote[]                 @relation("QuoteCreator")
  createdQuoteNotes             QuoteNote[]             @relation("QuoteNoteCreator")
  createdInvoices               Invoice[]               @relation("InvoiceCreator")
  createdInvoiceNotes           InvoiceNote[]           @relation("InvoiceNoteCreator")
  createdPayments               Payment[]               @relation("PaymentCreator")
  createdEmailCampaigns         EmailCampaign[]         @relation("EmailCampaignCreator")
  createdEmailTemplates         EmailTemplate[]         @relation("EmailTemplateCreator")
  createdEmailAutomations       EmailAutomation[]       @relation("EmailAutomationCreator")
  createdSegmentationRules      SegmentationRule[]      @relation("SegmentationRuleCreator")
  createdEmailProviders         EmailProvider[]         @relation("EmailProviderCreator")
  createdCalendarIntegrations   CalendarIntegration[]   @relation("CalendarIntegrationCreator")
  createdMeetings               Meeting[]               @relation("MeetingCreator")
  createdVideoConferenceConfigs VideoConferenceConfig[] @relation("VideoConferenceConfigCreator")
  createdChannels               Channel[]
  channelMemberships            ChannelMember[]
  channelReads                  ChannelRead[]
  messageReactions              MessageReaction[]
  pinnedMessages                Message[]               @relation("PinnedMessages")
  createdProducts               Product[]               @relation("ProductCreator")
  // Real estate: the agent who holds a listing, a mandate or a buyer's interest,
  // who recorded a viewing, and who decided an offer. Optional everywhere, set
  // null when the agent leaves, so attribution survives as history rather than
  // blocking the delete.
  ownedProperties               Property[]              @relation("PropertyOwner")
  createdProperties             Property[]              @relation("PropertyCreator")
  uploadedPropertyMedia         PropertyMedia[]         @relation("PropertyMediaUploader")
  ownedMandates                 Mandate[]               @relation("MandateOwner")
  createdMandates               Mandate[]               @relation("MandateCreator")
  changedMandatePrices          MandatePriceChange[]    @relation("MandatePriceChanger")
  ownedInterests                Interest[]              @relation("InterestOwner")
  ownedSearchBriefs             SearchBrief[]           @relation("SearchBriefOwner")
  commissionSplits              CommissionSplit[]       @relation("CommissionSplitUser")
  createdCommissions            Commission[]            @relation("CommissionCreator")
  createdSearchBriefs           SearchBrief[]           @relation("SearchBriefCreator")
  createdInterests              Interest[]              @relation("InterestCreator")
  createdOffers                 Offer[]                 @relation("OfferCreator")
  decidedOffers                 Offer[]                 @relation("OfferDecider")
  recordedViewingFeedback       ViewingFeedback[]       @relation("ViewingFeedbackRecorder")
  createdUniversalTemplates     UniversalTemplate[]     @relation("UniversalTemplateCreator")
  // Developer CRM (Promotion Immobilière)
  createdLandDeals              LandDeal[]              @relation("LandDealCreator")
  assignedLandDeals             LandDeal[]              @relation("LandDealAssignee")
  uploadedProgramMedia          ProgramMedia[]          @relation("ProgramMediaUploader")
  createdPrograms               Program[]               @relation("ProgramCreator")
}

model Channel {
  id          String          @id @default(cuid())
  name        String
  description String?
  workspaceId String
  createdById String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id])
  messages    Message[]
  // Private channels are visible only to their ChannelMember rows (plus the workspace owner)
  isPrivate   Boolean         @default(false)
  members     ChannelMember[]
  reads       ChannelRead[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

// Where each user has read up to in each channel; drives unread counts.
model ChannelRead {
  userId     String
  channelId  String
  lastReadAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Workspace {
  id                      String                  @id @default(cuid())
  name                    String
  description             String?
  icon                    String?
  // Currency for product prices and the default for new quotes and invoices
  currency                String                  @default("USD")
  ownerId                 String
  owner                   User                    @relation(fields: [ownerId], references: [id])
  members                 WorkspaceMember[]
  pages                   Page[]
  kanbanCards             KanbanCard[]
  kanbanProjects          KanbanProject[]
  pipelines               Pipeline[]
  leadLists               LeadList[]
  channels                Channel[]
  productCustomFields     ProductCustomField[]
  leadFiles               LeadFile[]
  properties              Property[]
  propertyMedia           PropertyMedia[]
  mandates                Mandate[]
  interests               Interest[]
  offers                  Offer[]
  viewingFeedback         ViewingFeedback[]
  searchBriefs            SearchBrief[]
  propertyMatches         PropertyMatch[]
  commissions             Commission[]
  commissionSplits        CommissionSplit[]
  // Developer CRM (Promotion Immobilière)
  landDeals               LandDeal[]
  programs                Program[]
  programMedia            ProgramMedia[]
  developmentLots         DevelopmentLot[]
  callsForFunds           CallForFunds[]
  tmaRequests             TMARequest[]
  handoverSnags           HandoverSnag[]
  messages                Message[]
  comments                Comment[]
  invitations             Invitation[]
  quotes                  Quote[]
  invoices                Invoice[]
  products                Product[]
  universalTemplates      UniversalTemplate[]
  emailCampaigns          EmailCampaign[]
  emailTemplates          EmailTemplate[]
  emails                  Email[]
  emailAutomations        EmailAutomation[]
  segmentationRules       SegmentationRule[]
  emailProviders          EmailProvider[]
  emailSuppressions       EmailSuppression[]
  emailUnsubscribes       EmailUnsubscribe[]
  emailBounces            EmailBounce[]
  // Scheduling relationships
  calendarIntegrations    CalendarIntegration[]
  meetings                Meeting[]
  videoConferenceConfigs  VideoConferenceConfig[]
  activities              Activity[]
  notifications           Notification[]
  // SaaS billing: the workspace's own subscription to BorsFlow.
  plan                    PlanTier                @default(FREE)
  stripeBillingCustomerId String?                 @unique
  trialEndsAt             DateTime?
  extraMemberPacks        Int                     @default(0) // each pack adds 10 members to the plan's cap
  subscription            Subscription?
  usageCounters           UsageCounter[]
  aiUsageEvents           AiUsageEvent[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String // 'owner', 'admin', 'member', 'viewer'
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model Page {
  id            String       @id @default(cuid())
  title         String
  icon          String?
  coverImage    String?
  workspaceId   String
  parentId      String?
  order         Int          @default(0)
  content       String       @default("{}") // Block-based content (stored as JSON string)
  isPublic      Boolean      @default(false) // When true, accessible via /share/[id] without auth
  createdById   String?
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        Page?        @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Page[]       @relation("PageHierarchy")
  createdBy     User?        @relation("PageCreator", fields: [createdById], references: [id])
  blocks        Block[]
  comments      Comment[]
  accessRecords PageAccess[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([createdById])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Block {
  id          String    @id @default(cuid())
  pageId      String
  type        String // 'text', 'heading', 'list', 'todo', 'divider', 'image', 'code', etc.
  content     String    @default("{}") // Stored as JSON string
  order       Int
  createdById String?
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("BlockCreator", fields: [createdById], references: [id])
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById])
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  blockId     String?
  pageId      String?
  userId      String
  workspaceId String
  parentId    String? // For threaded replies
  resolved    Boolean   @default(false)
  block       Block?    @relation(fields: [blockId], references: [id])
  page        Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([blockId])
  @@index([pageId])
  @@index([workspaceId])
  @@index([userId])
  @@index([parentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model KanbanProject {
  id          String       @id @default(cuid())
  name        String
  description String?
  color       String? // e.g. "#6366f1"
  workspaceId String
  order       Int          @default(0)
  createdById String?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("KanbanProjectCreator", fields: [createdById], references: [id])
  cards       KanbanCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([createdById])
}

model KanbanCard {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  status             String         @default("todo") // 'todo', 'inprogress', 'done'
  priority           String         @default("medium") // 'low', 'medium', 'high'
  tags               String? // JSON array of tags
  workspaceId        String
  projectId          String?
  order              Int            @default(0)
  dueDate            DateTime?
  assignees          String? // JSON array of user IDs
  attachments        Int            @default(0)
  comments           Int            @default(0)
  checklistCompleted Int            @default(0)
  checklistTotal     Int            @default(0)
  createdById        String?
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            KanbanProject? @relation(fields: [projectId], references: [id])
  createdBy          User?          @relation("KanbanCardCreator", fields: [createdById], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([createdById])
}

model Pipeline {
  id          String     @id @default(cuid())
  name        String
  description String?
  color       String? // Hex color for pipeline visualization
  workspaceId String
  order       Int        @default(0)
  stages      String     @default("[]") // JSON array of stage names
  /// What moves across this board: 'Lead' (enquiries not yet attached to a
  /// property), 'Interest' (one buyer's journey on one property) or 'Property'
  /// (the owner-acquisition funnel). See PIPELINE_SUBJECT_TYPES in
  /// src/lib/crm/subjects.ts.
  subjectType String     @default("Lead")
  createdById String?
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?      @relation("PipelineCreator", fields: [createdById], references: [id])
  leads       Lead[]
  properties  Property[]
  interests   Interest[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId])
  @@index([createdById])
}

model Lead {
  id                    String                 @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  company               String?
  position              String?
  status                String                 @default("new") // 'new', 'contacted', 'qualified', 'proposal', 'negotiation', 'won', 'lost'
  stage                 String                 @default("new") // Current stage in pipeline
  value                 Float? // Estimated deal value
  source                String? // How they found you
  notes                 String? // Additional notes
  tags                  String? // JSON array of tags
  pipelineId            String
  order                 Int                    @default(0)
  createdById           String?
  leadLists             LeadListLead[]
  pipeline              Pipeline               @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  createdBy             User?                  @relation("LeadCreator", fields: [createdById], references: [id])
  quotes                Quote[]
  invoices              Invoice[]
  emailRecipients       EmailRecipient[]
  segmentMembers        SegmentMember[]
  automationEnrollments AutomationEnrollment[]
  // Meeting relationships
  meetings              Meeting[]              @relation("LeadMeetings")
  meetingAttendees      MeetingAttendee[]      @relation("LeadAttendees")
  files                 LeadFile[]
  // Real estate. A lead is a buyer (interests, offers, viewing feedback) or a
  // vendor (the properties and mandates it is selling).
  vendorProperties      Property[]             @relation("PropertyVendor")
  vendorMandates        Mandate[]              @relation("MandateVendor")
  interests             Interest[]             @relation("InterestBuyer")
  offers                Offer[]                @relation("OfferBuyer")
  viewingFeedback       ViewingFeedback[]      @relation("ViewingFeedbackBuyer")
  searchBriefs          SearchBrief[]          @relation("SearchBriefLead")
  propertyMatches       PropertyMatch[]        @relation("PropertyMatchLead")
  // Developer CRM (Promotion Immobilière)
  vendorLandDeals       LandDeal[]             @relation("LandDealVendor")
  optionedLots          DevelopmentLot[]       @relation("LotOptionHolder")
  boughtLots            DevelopmentLot[]       @relation("LotBuyer")
  tmaRequests           TMARequest[]           @relation("TMABuyer")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([pipelineId])
  @@index([email])
  @@index([status])
  @@index([stage])
  @@index([createdById])
}

// A file attached to a prospect. Stored in the private storage bucket under
// crm/<workspaceId>/<leadId>/ and only served through short-lived signed URLs.
model LeadFile {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filePath     String
  fileName     String
  fileType     String
  size         Int
  uploadedById String?
  uploadedBy   User?     @relation("LeadFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([workspaceId])
}

model LeadList {
  id          String         @id @default(cuid())
  name        String
  description String?
  color       String? // Hex color for list visualization
  workspaceId String
  order       Int            @default(0)
  createdById String?
  leads       LeadListLead[]
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("LeadListCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdById])
}

model LeadListLead {
  id         String   @id @default(cuid())
  leadId     String
  leadListId String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadList   LeadList @relation(fields: [leadListId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([leadId, leadListId])
  @@index([leadListId])
}

model Product {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sku           String?
  price         Float     @default(0)
  unit          String?
  category      String?
  taxRate       Float     @default(0)
  stockQuantity Int?
  // Values for the workspace's ProductCustomField definitions, keyed by field key.
  customFields  Json      @default("{}")
  isActive      Boolean   @default(true)
  createdById   String?
  createdBy     User?     @relation("ProductCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceId, sku], map: "Product_workspaceId_sku_key")
  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
  @@index([category])
  @@index([isActive])
}

// A workspace-defined product attribute (e.g. unitsPerBox, brand). Values live
// in Product.customFields under `key`, which never changes once created.
model ProductCustomField {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Which table the values live on: 'product' (the services and fees catalog) or
  /// 'property' (a listing). The definitions, validation and coercion are the
  /// same for both, so properties reuse them rather than growing a second system.
  entityType  String    @default("product")
  key         String
  label       String
  type        String    @default("text") // 'text' | 'number' | 'boolean' | 'date'
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId, position])
}

model Message {
  id          String            @id @default(cuid())
  content     String
  workspaceId String
  userId      String
  channelId   String?
  fileUrl     String?
  fileName    String?
  fileType    String?
  // Object path in the private chat bucket; served through a signed-URL route.
  // fileUrl is kept only for rows written before files went private.
  filePath    String?
  editedAt    DateTime?
  // Soft delete: the row stays so threads and ordering survive; content is cleared.
  deletedAt   DateTime?
  // One level of threading: replies point at their parent and stay out of the main timeline.
  parentId    String?
  parent      Message?          @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]         @relation("ThreadReplies")
  pinnedAt    DateTime?
  pinnedById  String?
  pinnedBy    User?             @relation("PinnedMessages", fields: [pinnedById], references: [id], onDelete: SetNull)
  reactions   MessageReaction[]
  // Ably Chat message serial. Dedupe key between the live Ably stream and this archive,
  // and the idempotency key for the archive upsert. NULL for pre-Ably rows.
  ablySerial  String?           @unique
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id])
  channel     Channel?          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, channelId, createdAt])
  @@index([channelId, createdAt])
  @@index([parentId])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String // 'admin', 'member', 'viewer'
  status      String    @default("pending") // 'pending', 'accepted', 'declined', 'expired'
  token       String    @unique // Secure token for invitation acceptance
  workspaceId String
  senderId    String
  expiresAt   DateTime
  respondedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender      User      @relation("InvitationSender", fields: [senderId], references: [id])
  // receiver lookup is done at accept-time, not stored as FK (supports invites to non-registered users)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, email])
  @@index([email])
  @@index([token])
  @@index([status])
}

model Quote {
  id                   String      @id @default(cuid())
  quoteNumber          String
  // Unguessable token for the public client view at /view/quote/[token]. Null until
  // the quote is shared; rotating it revokes the old link.
  publicToken          String?     @unique
  publicTokenCreatedAt DateTime?
  workspaceId          String
  leadId               String?
  lead                 Lead?       @relation(fields: [leadId], references: [id])
  clientName           String
  clientEmail          String?
  clientPhone          String?
  clientCompany        String?
  clientAddress        String? // JSON object with address fields
  status               String      @default("draft") // 'draft', 'sent', 'viewed', 'accepted', 'rejected', 'expired'
  issueDate            DateTime    @default(now())
  validUntil           DateTime?
  currency             String      @default("USD")
  subtotal             Float       @default(0)
  taxRate              Float       @default(0)
  taxAmount            Float       @default(0)
  discountType         String? // 'percentage', 'fixed'
  discountValue        Float       @default(0)
  discountAmount       Float       @default(0)
  total                Float       @default(0)
  notes                String?
  terms                String?
  internalNotes        String? // Private notes for team
  sentAt               DateTime?
  viewedAt             DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  createdById          String?
  updatedBy            String?
  items                QuoteItem[]
  quoteNotes           QuoteNote[]
  invoices             Invoice[]
  workspace            Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User?       @relation("QuoteCreator", fields: [createdById], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([workspaceId, quoteNumber])
  @@index([workspaceId])
  @@index([leadId])
  @@index([status])
  @@index([quoteNumber])
  @@index([createdById])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  total       Float    @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteId])
}

model QuoteNote {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  content     String
  isPrivate   Boolean  @default(false) // true = internal notes, false = client-visible
  createdById String?
  createdBy   User?    @relation("QuoteNoteCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteId])
  @@index([createdById])
}

model Invoice {
  id                   String        @id @default(cuid())
  invoiceNumber        String
  // Unguessable token for the public client view at /view/invoice/[token]. Null
  // until the invoice is shared; rotating it revokes the old link.
  publicToken          String?       @unique
  publicTokenCreatedAt DateTime?
  workspaceId          String
  leadId               String?
  lead                 Lead?         @relation(fields: [leadId], references: [id])
  quoteId              String?
  quote                Quote?        @relation(fields: [quoteId], references: [id])
  clientName           String
  clientEmail          String?
  clientPhone          String?
  clientCompany        String?
  clientAddress        String? // JSON object with address fields
  status               String        @default("draft") // 'draft', 'sent', 'viewed', 'paid', 'overdue', 'cancelled'
  issueDate            DateTime      @default(now())
  dueDate              DateTime?
  paidDate             DateTime?
  currency             String        @default("USD")
  subtotal             Float         @default(0)
  taxRate              Float         @default(0)
  taxAmount            Float         @default(0)
  discountType         String? // 'percentage', 'fixed'
  discountValue        Float         @default(0)
  discountAmount       Float         @default(0)
  total                Float         @default(0)
  amountPaid           Float         @default(0)
  amountDue            Float         @default(0)
  paymentMethod        String? // For manual payment tracking
  paymentReference     String? // Reference number for payments
  notes                String?
  terms                String?
  internalNotes        String? // Private notes for team
  sentAt               DateTime?
  viewedAt             DateTime?
  createdById          String?
  updatedBy            String?
  items                InvoiceItem[]
  invoiceNotes         InvoiceNote[]
  payments             Payment[]
  callForFunds         CallForFunds?
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([leadId])
  @@index([quoteId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([dueDate])
  @@index([createdById])
}

