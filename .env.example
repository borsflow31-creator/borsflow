# Database
# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Cron Job Security
CRON_SECRET="your-cron-secret-here-generate-with-openssl-rand-base64-32"

# ─── Email Configuration ─────────────────────────────────────────────────────
# Choose the email provider: "resend" (default) or "smtp"
EMAIL_PROVIDER="resend"

# Unsubscribe link signing secret (generate: openssl rand -base64 32)
UNSUBSCRIBE_SECRET="your-unsubscribe-secret-here-generate-with-openssl-rand-base64-32"

# ─── Email Marketing Webhook Secrets ─────────────────────────────────────────
# Resend webhook signing secret (from Resend dashboard → Webhooks, starts with "whsec_")
# RESEND_WEBHOOK_SECRET="whsec_..."

# SendGrid webhook public key (from SendGrid → Mail Settings → Event Webhook → Signed Event Webhook)
# SENDGRID_WEBHOOK_PUBLIC_KEY="MFkwEwYHKoZIzj0CAQY..."

# Mailgun webhook signing key (from Mailgun → API Keys → HTTP Webhook Signing Key)
# MAILGUN_WEBHOOK_SIGNING_KEY="..."

# Postmark webhook token — add as ?token=... query param in the webhook URL
# POSTMARK_WEBHOOK_TOKEN="..."

# Sender address used by both providers
EMAIL_FROM="noreply@notion-alt.com"

# --- Resend (EMAIL_PROVIDER=resend) ---
# Get your key at https://resend.com/api-keys
RESEND_API_KEY="re_..."

# --- SMTP (EMAIL_PROVIDER=smtp) ---
# Works with any SMTP server (Gmail, Mailgun, Brevo, your own server, etc.)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false   # set to true for port 465 (SSL)
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"

# ─── Scheduling Integration ──────────────────────────────────────────────────

# Token encryption (generate: node -e "require('crypto').randomBytes(32).toString('hex')")
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here-generate-with-the-command-above"

# Google Calendar / Google Meet OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Webhook secret (optional, from Google Cloud Console)
# GOOGLE_WEBHOOK_SECRET=""

# Zoom OAuth
ZOOM_CLIENT_ID="your-zoom-oauth-client-id"
ZOOM_CLIENT_SECRET="your-zoom-oauth-client-secret"
ZOOM_WEBHOOK_SECRET_TOKEN="your-zoom-webhook-secret-token"

# Cal.com OAuth
CALCOM_CLIENT_ID="7efbe41b992ad260687f2bc73752551aa99dc6d35e575cf49a2e4c48de2ed037"
CALCOM_CLIENT_SECRET="your-calcom-oauth-client-secret"
CALCOM_WEBHOOK_SECRET="your-calcom-webhook-secret"

# ─── AI (GROQ) ───────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# ─── Stripe Connect ───────────────────────────────────────────────────────────
# Your platform's Stripe secret key (from dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Your Stripe publishable key (used client-side if needed)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret — get this from the Stripe CLI or Stripe Dashboard → Webhooks
# For local testing: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: platform fee percentage taken on each payment (e.g. "1.5" for 1.5%)
# Leave at "0" or unset to charge no platform fee
PLATFORM_FEE_PERCENT="0"

# ─── Ably Chat (realtime team chat) ──────────────────────────────────────────
# Root API key from ably.com → your app → API Keys. SERVER-ONLY: never prefix with
# NEXT_PUBLIC_. Browsers authenticate with short-lived tokens from /api/workspaces/[id]/chat/token.
ABLY_API_KEY="xxxxxx.yyyyyy:zzzzzzzzzzzzzzzz"

# ─── Supabase Storage (chat file uploads) ────────────────────────────────────
# Project URL and service-role key from Supabase → Project Settings → API. SERVER-ONLY.
# Create a *public* bucket with the name below (Storage → New bucket).
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_CHAT_BUCKET="chat-uploads"
